# PostgreSQL connection string
# Replace with your actual connection string from Neon / Supabase / Railway / etc.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/classroom_os?sslmode=require"

# Optional: Direct connection (required for Neon/Supabase with connection pooling)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/classroom_os?sslmode=require"

# NextAuth (optional for future auth)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Class {
  id        String     @id @default(cuid())
  name      String
  students  Student[]
  sessions  Session[]
  moodLogs  MoodLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Student {
  id               String            @id @default(cuid())
  name             String
  age              Int
  classId          String
  class            Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance       Attendance[]
  participation    Participation[]
  teamMembers      TeamMember[]
  reward           Reward?
  achievements     Achievement[]
  storyProgress    StoryProgress[]
  dailyChallenges  DailyChallenge[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([classId])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now()) @db.Date
  status    String
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}

model Session {
  id             String          @id @default(cuid())
  date           DateTime        @default(now()) @db.Date
  classId        String
  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  topic          String
  completed      Boolean         @default(false)
  mode           String          @default("class")
  teamSize       Int             @default(2)
  participation  Participation[]
  teams          Team[]
  activityEvents ActivityEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([classId])
  @@index([date])
}

model Participation {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  score     Int
  createdAt DateTime @default(now())

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
}

model MoodLog {
  id           String   @id @default(cuid())
  date         DateTime @default(now()) @db.Date
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  happyCount   Int      @default(0)
  neutralCount Int      @default(0)
  sadCount     Int      @default(0)
  angryCount   Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([classId, date])
  @@index([classId])
}

model Team {
  id        String       @id @default(cuid())
  sessionId String
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  color     String
  xp        Int          @default(0)
  members   TeamMember[]
  createdAt DateTime     @default(now())

  @@index([sessionId])
}

model TeamMember {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentId])
  @@index([teamId])
  @@index([studentId])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       String
  studentIds String[]
  xpAwarded  Int      @default(0)
  bonusXP    Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

model Reward {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  xp        Int      @default(0)
  level     Int      @default(0)
  streak    Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String
  label     String
  icon      String
  date      DateTime @default(now())

  @@unique([studentId, type])
  @@index([studentId])
}

// ─── NEW: Story progress tracking ─────────────────────────────────────────────
model StoryProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storyId     String
  pagesRead   Int      @default(0)
  completed   Boolean  @default(false)
  xpEarned    Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([studentId, storyId])
  @@index([studentId])
}

// ─── NEW: Daily challenge tracking ────────────────────────────────────────────
model DailyChallenge {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  topic       String
  completed   Boolean  @default(false)
  xpEarned    Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}
